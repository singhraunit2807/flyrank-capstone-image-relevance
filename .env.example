APP_ENV=development

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Production API bearer token
FLYRANK_API_TOKEN=

# Optional persistent Supabase PostgreSQL database (include sslmode=require in URL)
DATABASE_URL=

# Optional persistent Supabase Storage for uploaded image files
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=flyrank-images

# Local-only fallback storage
DATABASE_PATH=data/flyrank.db
UPLOAD_DIR=data/uploads
